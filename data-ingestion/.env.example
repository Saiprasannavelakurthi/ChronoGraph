# ─────────────────────────────────────────────────────────────────────────────
# ChronoGraph – Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ─── LLM Provider Configuration ─────────────────────────────────────────────
# Supported options: "groq" | "openai" | "ollama" | "mock" | "fallback"
#   groq     - Groq Cloud API (fast inference; requires GROQ_API_KEY)
#   openai   - OpenAI API (requires OPENAI_API_KEY)
#   ollama   - Local Ollama server (requires local Ollama installation)
#   mock     - Heuristic rule-based extractor (no external services or API keys needed)
#   fallback - Synonym for mock
LLM_PROVIDER=groq
LLM_MODEL=

# ─── Groq Configuration ──────────────────────────────────────────────────────
# Free API key: https://console.groq.com/
# Default model: llama-3.1-8b-instant
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# ─── OpenAI Configuration ───────────────────────────────────────────────────
# Required when LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ─── Ollama Configuration ───────────────────────────────────────────────────
# Required when LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ─── Data Paths ──────────────────────────────────────────────────────────────
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed

# ─── API Configuration ───────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
# Production safe: auto-reload disabled by default (enable only in development)
API_RELOAD=false

# Allowed CORS origins (comma-separated). Safe development default:
# In production, set to your specific frontend domains.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Extraction Settings ─────────────────────────────────────────────────────
EXTRACTION_MAX_EVENTS=0
EXTRACTION_MIN_CONFIDENCE=0.5

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
