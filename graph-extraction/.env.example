# LLM Configuration (Groq / Ollama / OpenAI-compatible)
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=gsk_your_groq_api_key_here
LLM_TEMPERATURE=0.0

# Optional Local Ollama Settings (Alternative to Groq)
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3
# LLM_BASE_URL=http://localhost:11434

# Extraction Pipeline Settings
EXTRACTION_MAX_RETRIES=2
LOG_LEVEL=INFO

